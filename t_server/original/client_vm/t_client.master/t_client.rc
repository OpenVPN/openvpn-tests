# Test 10x: UDP / p2mp tun, no CA / FP auth / wrong server FP
#  (Hash-Check-Fail zaehlt nicht als "AUTH FAIL" sondern -> retry)
# 2021-04-28 10:49:49 TLS Error: --tls-verify/--peer-fingerprintcertificate hash verification failed. (got fingerprint: 1e:20:37:6f:ae:9a:bc:df:3f:8a:54:34:a6:bd:9b:19:42:64:ba:1a:cd:37:b3:a7:9a:e1:32:d3:26:ce:6f:e8
# ...
# 2021-04-28 10:49:49 SIGUSR1[soft,tls-error] received, process restarting
# 2021-04-28 10:49:49 Restart pause, 5 second(s)
# 2021-04-28 10:49:54 All connections have been connect-retry-max (1) times unsuccessful, exiting
# 2021-04-28 10:49:54 Exiting due to fatal error

RUN_TITLE_10x="udp / p2pm / FP + script auth / FAIL: wrong FP"
OPENVPN_CONF_10x="$BASE_CONF_10 --auth-user-pass $AUTH_DIR/aup.txt \
    --peer-fingerprint FF:FF:37:6F:AE:9A:BC:DF:3F:8A:54:34:A6:BD:9B:19:42:64:BA:1A:CD:37:B3:A7:9A:E1:32:D3:26:CE:6F:E8 \
    --connect-retry-max 1 --connect-retry 1"
EXPECT_IFCONFIG4_10x=-
EXPECT_IFCONFIG6_10x=-
EXPECT_FAIL_10x="hash verification failed"


# Test 10z: UDP / p2mp tun, no CA / FP auth (server side only)
# das schimmelt alles etwas wg "--retry-max 1 ist 2", trac #1403
#  (Multi-Address-Problem, "mit udp4/udp6" wuerde er nur 1x versuchen)
RUN_TITLE_10z="udp / p2pm / FP+script auth / FAIL: invalid cert"
OPENVPN_CONF_10z="$OPENVPN_BASE_P2MP \
                 --key $KEYBASE/cron2-freebsd-tc-amd64-24.key \
                 --cert $KEYBASE/cron2-freebsd-tc-amd64-24.crt \
                 --dev tun --proto udp --remote $REMOTE --port 51200 \
	         --auth-user-pass $AUTH_DIR/aup.txt \
		 --connect-retry 0 --connect-retry-max 1 --hand-window 5"
EXPECT_IFCONFIG4_10z=-
EXPECT_IFCONFIG6_10z=-
#EXPECT_FAIL_10z="TLS Error: TLS key negotiation failed to occur"
EXPECT_FAIL_10z="All connections have been connect-retry-max"

# UDP P2P TLS tests
# kein --explicit-exit-notify, weil dann der Server stirbt (wat?)
#
# Test 11: UDP / p2p tun, TLS, SHA256
RUN_TITLE_11="udp / p2p / TLS / SHA1-SHA256 (NCP) / v4"
BASE_CONF_11="--tls-client --cert $CLIENT_CERT --key $CLIENT_KEY \
	      --ca $CA_CERT --remote-cert-tls server --nobind --verb 3 \
              --dev tun --proto udp4 --remote $REMOTE --port 51201 \
	      --topology subnet --ifconfig 10.204.11.4 255.255.255.0 \
	      --ifconfig-ipv6 fd00:abcd:204:11::1004/64 fd00:abcd:204:11::1 \
	      --route 10.204.0.0 255.255.0.0 10.204.11.1 \
	      --route-ipv6 fd00:abcd:204::/48"

OPENVPN_CONF_11="$BASE_CONF_11"
EXPECT_IFCONFIG4_11=10.204.11.4
EXPECT_IFCONFIG6_11=fd00:abcd:204:11::1004
PING4_HOSTS_11="10.204.11.1 10.204.0.1"
PING6_HOSTS_11="fd00:abcd:204:11::1 fd00:abcd:204:0::1"

# 23.5.22: das bricht, wenn man es direkt nach _11 macht, weil
# der Server dann "dieselbe Instance" re-used, und AES-256-GCM macht
RUN_TITLE_11a="udp / p2p / TLS / SHA256 (BF-only) / v6"
OPENVPN_CONF_11a="$BASE_CONF_11 --providers legacy default --data-ciphers BF-CBC --auth SHA256 --proto udp6"
EXPECT_IFCONFIG4_11a=$EXPECT_IFCONFIG4_11
EXPECT_IFCONFIG6_11a=$EXPECT_IFCONFIG6_11
PING4_HOSTS_11a="$PING4_HOSTS_11"
PING6_HOSTS_11a="$PING6_HOSTS_11"

# gleich nochmal connecten, nach 400s delay (+reneg-sec 300 auf dem Server)
#  -> BUG, Server key state geht komplett kaputt
RUN_TITLE_11t="udp4 / p2p / TLS / SHA1-SHA256 (NCP) / 400s pre-delay"
PREPARE_11t="date ; sleep 400 ; date"
OPENVPN_CONF_11t="$BASE_CONF_11 --proto udp4"
EXPECT_IFCONFIG4_11t=$EXPECT_IFCONFIG4_11
EXPECT_IFCONFIG6_11t=$EXPECT_IFCONFIG6_11
PING4_HOSTS_11t="$PING4_HOSTS_11"
PING6_HOSTS_11t="$PING6_HOSTS_11"


# 30.11.22 "the lala land test"
# most important: the *server* must not get stuck in lala land
RUN_TITLE_11z="udp / p2p / TLS / none 'lala land'"
OPENVPN_CONF_11z="$BASE_CONF_11 --data-ciphers none --auth SHA256 --connect-retry-max 1"
EXPECT_IFCONFIG4_11z=$EXPECT_IFCONFIG4_11
EXPECT_IFCONFIG6_11z=$EXPECT_IFCONFIG6_11
PING4_HOSTS_11z="$PING4_HOSTS_11"
PING6_HOSTS_11z="$PING6_HOSTS_11"
EXPECT_FAIL_11z="ERROR: Failed to apply P2P negotiated protocol options"

